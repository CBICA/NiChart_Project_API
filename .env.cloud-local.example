# Cloud-local testing credentials.
# Copy to .env.cloud-local, then fill in the AWS_ values.
# .env.cloud-local is git-ignored — NEVER commit real credentials.
#
# The easiest way to populate this file is:
#   scripts/export-cloud-creds.sh <task-role-arn>
#
# Credentials expire after 1 hour by default; re-run the script to refresh.

# Temporary credentials assumed from the NiChart ECS task role
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
